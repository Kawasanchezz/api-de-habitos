{
  "info": {
    "name": "API de Hábitos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "habitId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Sistema",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Hábitos",
      "item": [
        {
          "name": "Criar hábito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Beber 2L de água\",\n  \"description\": \"Manter-se hidratado\",\n  \"frequency\": \"daily\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/habits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Listar hábitos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits?active=true&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits"
              ],
              "query": [
                {
                  "key": "active",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar hábito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{habitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{habitId}}"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Atualizar hábito",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Beber 3L de água\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/habits/{{habitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{habitId}}"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Excluir hábito",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{habitId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{habitId}}"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Registros",
      "item": [
        {
          "name": "Marcar hoje",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Feito!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/habits/{{habitId}}/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{habitId}}",
                "check"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Marcar em data específica",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-11-01\",\n  \"note\": \"Retroativo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/habits/{{habitId}}/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{habitId}}",
                "check"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Desmarcar data",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{habitId}}/check/2026-11-01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{habitId}}",
                "check",
                "2026-11-01"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Registros do hábito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{habitId}}/logs?from=2026-11-01&to=2026-11-30&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{habitId}}",
                "logs"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-11-01"
                },
                {
                  "key": "to",
                  "value": "2026-11-30"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Todos os registros (filtros)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logs?habit_id={{habitId}}&from=2026-11-01&to=2026-11-30&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logs"
              ],
              "query": [
                {
                  "key": "habit_id",
                  "value": "{{habitId}}"
                },
                {
                  "key": "from",
                  "value": "2026-11-01"
                },
                {
                  "key": "to",
                  "value": "2026-11-30"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Estatísticas",
      "item": [
        {
          "name": "Estatísticas do hábito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/habits/{{habitId}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "habits",
                "{{habitId}}",
                "stats"
              ],
              "query": []
            }
          }
        }
      ]
    }
  ]
}